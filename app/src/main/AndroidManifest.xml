<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.aiframeinterpolation">

    <!-- Required for running a Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 10+ when using MediaProjection in a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ (Tiramisu): request this at runtime if you show a notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- If you also capture audio (mic or playback), add:
         <uses-permission android:name="android.permission.RECORD_AUDIO" />
         and include "microphone" in foregroundServiceType: mediaProjection|microphone
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- Foreground service used to host MediaProjection -->
        <service
            android:name=".ProjectionFgService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>


